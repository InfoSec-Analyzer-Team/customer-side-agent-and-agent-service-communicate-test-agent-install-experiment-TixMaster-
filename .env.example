# ------------------------------------------------------------------
# [TixMaster Configuration Template]
# INSTRUCTIONS:
# 1. Copy this file and rename it to ".env"
# 2. Ask PM (Your Name) for the real secrets
# 3. NEVER commit the real .env file to GitHub!
# ------------------------------------------------------------------

# [Security - Authentication (Auth0)]
# The secret key used to encrypt the session cookie.
# Run `openssl rand -hex 32` to generate one.
AUTH0_SECRET='YOUR_GENERATED_32_BYTE_SECRET_HERE'

# The base URL of your application.
# For local development, this is usually localhost.
AUTH0_BASE_URL='http://localhost:3000'

# The URL of your Auth0 tenant domain.
# Format: https://dev-xxxxx.us.auth0.com
AUTH0_ISSUER_BASE_URL='https://YOUR_AUTH0_DOMAIN.auth0.com'

# The "Username" of this app in Auth0.
AUTH0_CLIENT_ID='YOUR_AUTH0_CLIENT_ID_HERE'

# The "Password" of this app in Auth0. (CRITICAL SECRET!)
AUTH0_CLIENT_SECRET='__ASK_PM_FOR_REAL_SECRET__'

# [Local Postgres via docker-compose.db.yml]
# 只有全新 volume 第一次啟動時會生效（見 docker-compose.db.yml 開頭註解）
POSTGRES_USER='tixmaster'
POSTGRES_PASSWORD='__CHANGE_ME__'
POSTGRES_DB='tixmaster'
POSTGRES_PORT='5432'

# [Local nginx reverse-proxy via docker-compose.nginx.yml]
# 預設只綁 127.0.0.1（任何機器都能直接跑）。要讓同一個 ZeroTier/VPN 網段的
# 其他機器連進來測試，才需要覆寫成你自己的 ZeroTier IP。
NGINX_BIND_HOST='127.0.0.1'

# [Feature Toggles (HDD Experiment)]
# Enable/Disable the countdown timer on checkout page (true/false)
ENABLE_CHECKOUT_TIMER='false'

# Enable/Disable the viewer count on event page (true/false)
ENABLE_VIEWING_COUNT='false'