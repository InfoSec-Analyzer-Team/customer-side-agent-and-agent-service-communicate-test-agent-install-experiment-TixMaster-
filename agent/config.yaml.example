# XDR Agent Configuration
# Copy to config.yaml and fill in your values.

tenant_id: "tenant-demo-001"
gateway_url: "http://localhost:80"

# Ingest API Key（由平台 Portal 產生，明碼僅顯示一次）。
# 建議改用環境變數 XDR_API_KEY 帶入（見 xdr-agent.service 的 EnvironmentFile），
# 避免明碼憑證落進版控；環境變數優先於此處。留空＝匿名（Gateway 過渡期仍放行）。
# api_key: "lac_xxxxxxxxxxxxxxxx"

# 本 Agent 在平台的識別碼（Portal 新增 Agent 時產生）。可留空。
# agent_id: "agent-xxxxxxxxxxxx"

sources:
  - type: file
    path: /var/log/nginx/access.log
    format: nginx_combined
  # - type: file
  #   path: /var/log/apache2/access.log
  #   format: apache_combined

batch:
  flush_interval_sec: 180   # flush every 3 minutes
  chunk_size: 5000          # max events per POST; auto-splits if exceeded

buffer:
  path: /var/lib/xdr-agent/buffer.db
  max_size_mb: 200

retry:
  max_attempts: 10
  base_delay_sec: 1
  max_delay_sec: 60

checkpoint:
  path: /var/lib/xdr-agent/checkpoint.json

logging:
  level: INFO   # DEBUG / INFO / WARNING / ERROR
  path: /var/log/xdr-agent/agent.log
